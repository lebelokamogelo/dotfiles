{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "mpris",
    "group/stats",
    "group/controls",
    "tray",
    "group/session"
  ],

  "group/stats": {
    "orientation": "horizontal",
    "modules": ["custom/temp", "cpu", "memory"]
  },

  "group/controls": {
    "orientation": "horizontal",
    "modules": ["backlight", "pulseaudio", "network", "bluetooth", "battery"]
  },

  "group/session": {
    "orientation": "horizontal",
    "modules": ["custom/noctalia", "custom/notification", "custom/power"]
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by-number": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Brave": "$1",
      "(.*) - Brave": "$1",
      "": ""
    }
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#82dccc'><b>{}</b></span>",
        "days": "<span color='#dddddd'>{}</span>",
        "weekdays": "<span color='#798bb2'><b>{}</b></span>",
        "today": "<span color='#01ccff'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "mpris": {
    "format": "{player_icon}  {dynamic}",
    "format-paused": "{status_icon}  <i>{dynamic}</i>",
    "dynamic-order": ["title", "artist"],
    "dynamic-separator": " — ",
    "max-length": 34,
    "player-icons": { "default": "󰎇", "mpv": "󰐹", "brave": "󰝚", "firefox": "󰈹" },
    "status-icons": { "paused": "󰏤", "stopped": "󰓛" },
    "tooltip-format": "{player}: {title}\n{artist}"
  },

  "custom/temp": {
    "exec": "~/.config/waybar/scripts/temp.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 5,
    "tooltip": true,
    "on-click": "kitty -e btop"
  },

  "memory": {
    "format": "󰆼 {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
    "on-click": "kitty -e btop"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip-format": "Brightness {percent}%"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-bluetooth": "󰂰 {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} — {volume}%"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-linked": "󰤩",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ipaddr}\n↓ {bandwidthDownBits}   ↑ {bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-off": "Bluetooth off",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\n{power:0.1f} W  •  {health}% health",
    "interval": 30
  },

  "tray": {
    "spacing": 12,
    "icon-size": 16
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/noctalia": {
    "format": "󰒓",
    "tooltip-format": "Noctalia settings",
    "on-click": "noctalia msg settings-open || (setsid noctalia --daemon >/dev/null 2>&1 & sleep 2 && noctalia msg settings-open)"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Session menu",
    "on-click": "wlogout -b 5"
  }
}
