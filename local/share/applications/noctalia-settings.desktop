[Desktop Entry]
Type=Application
Name=Noctalia Settings
Comment=Open the Noctalia shell settings panel
Exec=sh -c "noctalia msg settings-open || { noctalia --daemon && noctalia msg settings-open; }"
Icon=noctalia-white
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=noctalia;shell;bar;config;configuration;
StartupNotify=false
